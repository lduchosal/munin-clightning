#!/bin/sh
# -*- sh -*-
# vim: ft=sh

: << =cut

=head1 NAME

lightningd_sql_channels_health - Plugin to monitor channel health metrics via SQL

=head1 CONFIGURATION

 [lightningd_*]
    user bitcoin
    env.binary lightning-cli
    env.data_dir /var/db/c-lightning

=head1 AUTHOR

Luc Duchosal

=head1 LICENSE

AGPLv3+

=head1 MAGIC MARKERS

 #%# family=auto
 #%# capabilities=autoconf

=cut

BINARY=${binary:-"/usr/local/bin/lightning-cli"}
DATA_DIR=${data_dir:-"/var/db/c-lightning"}

if [ ! -x "$BINARY" ]; then
    BINARY=$(which lightning-cli 2>/dev/null || echo "/usr/local/bin/lightning-cli")
fi

sql_query() {
    $BINARY --lightning-dir=$DATA_DIR sql "$1" 2>/dev/null
}

if [ "$1" = "test" ] || [ "$1" = "test2" ]; then
    echo
    echo "# "
    echo "# $0 $1"
    echo "# "
    echo
fi

if [ "$1" = "autoconf" ]; then
    if command -v $BINARY >/dev/null && [ -d "$DATA_DIR" ]; then
        echo "yes"
    else
        echo "no"
    fi
    exit 0
fi

#
# Queries
#

# Channel states
CHANNEL_STATES=$(sql_query "SELECT
    state,
    COUNT(*) as count
FROM peerchannels
GROUP BY state")

# Connection status
CONNECTION_STATUS=$(sql_query "SELECT
    SUM(CASE WHEN peer_connected = 1 THEN 1 ELSE 0 END) as connected,
    SUM(CASE WHEN peer_connected = 0 THEN 1 ELSE 0 END) as disconnected,
    COUNT(*) as total
FROM peerchannels
WHERE state = 'CHANNELD_NORMAL'")

# HTLC stats
HTLC_STATS=$(sql_query "SELECT
    COUNT(*) as total_htlcs,
    SUM(amount_msat) as total_amount
FROM peerchannels_htlcs")

# HTLC per direction
HTLC_DIRECTION=$(sql_query "SELECT
    direction,
    COUNT(*) as count,
    SUM(amount_msat) as amount
FROM peerchannels_htlcs
GROUP BY direction")

# Payment stats per channel
PAYMENT_STATS=$(sql_query "SELECT
    short_channel_id,
    in_payments_offered,
    in_payments_fulfilled,
    out_payments_offered,
    out_payments_fulfilled,
    in_fulfilled_msat,
    out_fulfilled_msat
FROM peerchannels
WHERE state = 'CHANNELD_NORMAL' AND short_channel_id IS NOT NULL")

# Fee rates
FEE_STATS=$(sql_query "SELECT
    AVG(local_fee_base_msat) as avg_base,
    AVG(local_fee_proportional_millionths) as avg_ppm,
    MIN(local_fee_base_msat) as min_base,
    MAX(local_fee_base_msat) as max_base,
    MIN(local_fee_proportional_millionths) as min_ppm,
    MAX(local_fee_proportional_millionths) as max_ppm
FROM peerchannels
WHERE state = 'CHANNELD_NORMAL'")

# Feerate (on-chain)
FEERATE_STATS=$(sql_query "SELECT
    AVG(feerate_perkw) as avg_feerate,
    MIN(feerate_perkw) as min_feerate,
    MAX(feerate_perkw) as max_feerate
FROM peerchannels
WHERE state = 'CHANNELD_NORMAL' AND feerate_perkw IS NOT NULL")

# Test mode - mock data
if [ "$1" = "test" ]; then
    CHANNEL_STATES='{"rows":[["CHANNELD_NORMAL", 5], ["CHANNELD_AWAITING_LOCKIN", 1], ["ONCHAIN", 2]]}'
    CONNECTION_STATUS='{"rows":[[4, 1, 5]]}'
    HTLC_STATS='{"rows":[[12, 5000000000]]}'
    HTLC_DIRECTION='{"rows":[["in", 6, 2500000000], ["out", 6, 2500000000]]}'
    PAYMENT_STATS='{"rows":[["694360x1604x1", 100, 95, 80, 75, 50000000000, 40000000000]]}'
    FEE_STATS='{"rows":[[1000, 500, 0, 2000, 100, 1000]]}'
    FEERATE_STATS='{"rows":[[2500, 1000, 5000]]}'
fi

if [ "$1" = "test2" ]; then
    CHANNEL_STATES='{"rows":[]}'
    CONNECTION_STATUS='{"rows":[[0, 0, 0]]}'
    HTLC_STATS='{"rows":[[0, 0]]}'
    HTLC_DIRECTION='{"rows":[]}'
    PAYMENT_STATS='{"rows":[]}'
    FEE_STATS='{"rows":[[0, 0, 0, 0, 0, 0]]}'
    FEERATE_STATS='{"rows":[[0, 0, 0]]}'
fi

if [ "$1" = "debug" ] || [ "$2" = "debug" ]; then
    echo "CHANNEL_STATES:"
    echo "$CHANNEL_STATES" | jq .
    echo "CONNECTION_STATUS:"
    echo "$CONNECTION_STATUS" | jq .
fi

# Parse results
connected=$(echo "$CONNECTION_STATUS" | jq -r '.rows[0][0] // 0')
disconnected=$(echo "$CONNECTION_STATUS" | jq -r '.rows[0][1] // 0')
total_channels=$(echo "$CONNECTION_STATUS" | jq -r '.rows[0][2] // 0')

total_htlcs=$(echo "$HTLC_STATS" | jq -r '.rows[0][0] // 0')
htlc_amount=$(echo "$HTLC_STATS" | jq -r '.rows[0][1] // 0')
htlc_amount_sat=$((htlc_amount / 1000))

# Parse HTLC directions
htlcs_in=$(echo "$HTLC_DIRECTION" | jq -r '.rows[] | select(.[0] == "in") | .[1] // 0' 2>/dev/null | head -1)
htlcs_out=$(echo "$HTLC_DIRECTION" | jq -r '.rows[] | select(.[0] == "out") | .[1] // 0' 2>/dev/null | head -1)
htlcs_in=${htlcs_in:-0}
htlcs_out=${htlcs_out:-0}

# Fee stats
avg_base=$(echo "$FEE_STATS" | jq -r '.rows[0][0] // 0' | cut -d. -f1)
avg_ppm=$(echo "$FEE_STATS" | jq -r '.rows[0][1] // 0' | cut -d. -f1)
min_ppm=$(echo "$FEE_STATS" | jq -r '.rows[0][4] // 0')
max_ppm=$(echo "$FEE_STATS" | jq -r '.rows[0][5] // 0')

# On-chain feerate
avg_feerate=$(echo "$FEERATE_STATS" | jq -r '.rows[0][0] // 0' | cut -d. -f1)

# Calculate connection ratio
if [ "$total_channels" -gt 0 ]; then
    connection_ratio=$((connected * 100 / total_channels))
else
    connection_ratio=0
fi

#
# Config
#

if [ "$1" = "config" ]; then
    cat <<EOF
multigraph sql_channels_connection
graph_title Channel Connection Status
graph_vlabel count
graph_category lightningd
graph_info Connection status of channels

connected.label Connected
connected.draw AREASTACK
connected.colour 00AA00
disconnected.label Disconnected
disconnected.draw AREASTACK
disconnected.colour AA0000

multigraph sql_channels_connection_ratio
graph_title Channel Connection Ratio
graph_vlabel percent
graph_category lightningd
graph_info Percentage of channels connected
graph_args --lower-limit 0 --upper-limit 100

ratio.label Connected %
ratio.draw LINE2
ratio.warning 70:
ratio.critical 50:

multigraph sql_channels_states
graph_title Channel States
graph_vlabel count
graph_category lightningd
graph_info Distribution of channel states

EOF

    # Dynamic states
    echo "$CHANNEL_STATES" | jq -r '.rows[]? | .[0]' 2>/dev/null | while read state; do
        if [ -n "$state" ] && [ "$state" != "null" ]; then
            safe_state=$(echo "$state" | tr -cd 'a-zA-Z0-9_')
            echo "state_${safe_state}.label $state"
            echo "state_${safe_state}.draw AREASTACK"
        fi
    done

    cat <<EOF

multigraph htlcs_active
graph_title Active HTLCs
graph_vlabel count
graph_category lightningd
graph_info Currently active HTLCs

total.label Total
total.draw LINE2
incoming.label Incoming
incoming.draw AREASTACK
incoming.colour 00AA00
outgoing.label Outgoing
outgoing.draw AREASTACK
outgoing.colour 0000AA

multigraph htlcs_amount
graph_title HTLC Locked Amount
graph_vlabel sats
graph_category lightningd
graph_info Amount locked in HTLCs

amount.label Locked
amount.draw AREA
amount.colour FFAA00

multigraph fees_local
graph_title Local Fee Rates
graph_vlabel ppm / msat
graph_category lightningd
graph_info Fee rates configured on our channels

avg_ppm.label Avg PPM
avg_ppm.draw LINE2
min_ppm.label Min PPM
min_ppm.draw LINE1
max_ppm.label Max PPM
max_ppm.draw LINE1
avg_base.label Avg Base (msat)
avg_base.draw LINE2

multigraph feerate_onchain
graph_title On-Chain Feerate
graph_vlabel sat/kw
graph_category lightningd
graph_info On-chain feerate for channels

feerate.label Avg Feerate
feerate.draw LINE2
EOF

    exit 0
fi

#
# Values
#

cat <<EOF
multigraph sql_channels_connection

connected.value $connected
disconnected.value $disconnected

multigraph sql_channels_connection_ratio

ratio.value $connection_ratio

multigraph sql_channels_states

EOF

# Per-state values
echo "$CHANNEL_STATES" | jq -c '.rows[]?' 2>/dev/null | while read row; do
    state=$(echo "$row" | jq -r '.[0]')
    count=$(echo "$row" | jq -r '.[1] // 0')

    if [ -n "$state" ] && [ "$state" != "null" ]; then
        safe_state=$(echo "$state" | tr -cd 'a-zA-Z0-9_')
        echo "state_${safe_state}.value $count"
    fi
done

cat <<EOF

multigraph htlcs_active

total.value $total_htlcs
incoming.value $htlcs_in
outgoing.value $htlcs_out

multigraph htlcs_amount

amount.value $htlc_amount_sat

multigraph fees_local

avg_ppm.value $avg_ppm
min_ppm.value $min_ppm
max_ppm.value $max_ppm
avg_base.value $avg_base

multigraph feerate_onchain

feerate.value $avg_feerate
EOF
